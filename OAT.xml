<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <oatconfig>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem type="compatibility" name="MPL-2.0" path=".*" desc="" />
                <policyitem type="compatibility" name="GPL-2.0+" path=".*" desc="" />
                <policyitem type="compatibility" name="LGPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="GPL-3.0+" path=".*" desc="" />
                <policyitem type="compatibility" name="LGPL-2.1+" path=".*" desc="" />
                <policyitem type="compatibility" name="GPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="BSD-3-Clause|GPLStyleLicense" path=".*" desc="" />
                <policyitem type="compatibility" name="Khronos License1" path=".*" desc="" />
                <policyitem type="compatibility" name="Khronos License2" path=".*" desc="" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultPolicyFilter"
                desc="Filters for compatibility,license header policies">
                <filteritem type="filepath" name="doc/snippets"
                    desc="" />
                <filteritem type="filepath" name=".*krazy"
                    desc="" />
                <filteritem type="filepath" name="doc/special_examples/random_cpp11.cpp"
                    desc="" />
                <filteritem type="filepath" name="bench/perf_monitoring/resources/s2.js"
                    desc="" />
                <filteritem type="filepath" name="COPYING.MINPACK"
                    desc="" />
                <filteritem type="filepath" name="LICENSE"
                    desc="" />
                 <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
            <filefilter name="defaultFilter">
                <filteritem type="filepath" name="README.OpenSource"
                    desc="" />
            </filefilter>
        </filefilterlist>
        <licensematcherlist>
            <licensematcher name="Khronos License1" desc="">
                <licensetext name="
                /* Local variables */
            " desc="" />
            </licensematcher>
            <licensematcher name="Khronos License2" desc="">
                <licensetext name="
                This file is part of Eigen, a lightweight C++ template library
                for linear algebra.
            " desc="" />
            </licensematcher>
        </licensematcherlist>
    </oatconfig>
</configuration>